{
  "name": "kete-kopaki-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start": "expo start --web --port 19006 --non-interactive",
    "build:web": "expo export --platform web",
    "serve:web": "npx serve dist -l 19006",
    "test:unit": "node -e \"console.log('No frontend unit tests yet')\"",
    "test:functional": "playwright test --config tests/functional/playwright.config.js"
  },
  "dependencies": {
    "expo": "^54.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "serve": "^14.2.4"
  }
}
